# SAHAYAK — Supabase Configuration
# Replace with your project credentials from the Supabase dashboard (Settings > API)

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Storage Bucket for private document uploads (Defaults to user-documents)
VITE_SUPABASE_STORAGE_BUCKET=user-documents
